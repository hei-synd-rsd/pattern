{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${userHome}/.platformio/packages/framework-zephyr/include",
                "${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/arm-none-eabi/include",
                "${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/lib/gcc/**",
                "${workspaceFolder}/**",
                "${workspaceFolder}/../../../../test-bench/common"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "XF_PORT_ZEPHYR",
                "USE_XF_PORT_ZEPHYR_XF_CLASS",
                "USE_XF_PORT_ZEPHYR_DISPATCHER_CLASS",
                "USE_XF_PORT_ZEPHYR_EVENT_QUEUE_CLASS",
                "USE_XF_PORT_ZEPHYR_MUTEX_CLASS",
                "USE_XF_PORT_ZEPHYR_THREAD_CLASS"
            ],
            "compilerPath": "${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
